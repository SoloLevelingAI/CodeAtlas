<Window x:Class="CodeAtlas.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CodeAtlas.Desktop" xmlns:ex="clr-namespace:CodeAtlas.Exploration;assembly=CodeAtlas.Exploration"
 Title="Code Atlas · Desktop" Style="{StaticResource {x:Type Window}}" Width="1440" Height="900" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SizeChanged="OnWindowSizeChanged" Closed="OnClosed" PreviewKeyDown="OnKeys">
 <Window.Resources>
  <HierarchicalDataTemplate DataType="{x:Type ex:ExplorerItem}" ItemsSource="{Binding Children}">
   <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="NodeTitle" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,10,0" TextWrapping="Wrap" MaxHeight="38"/>
    </StackPanel><TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="10" Margin="12,2,0,0" Foreground="{StaticResource Muted}"/>
   </Grid>
   <HierarchicalDataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="模块"><Setter TargetName="NodeTitle" Property="FontSize" Value="17"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="职责"><Setter TargetName="NodeTitle" Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
  <Style TargetType="TreeViewItem">
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><local:AtlasVirtualizingPanel/></ItemsPanelTemplate></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded,Mode=OneWay}" Click="OnToggleNode" VerticalAlignment="Top" Margin="0,14,0,0" Focusable="False" Background="Transparent" BorderThickness="0" Width="22" Height="24">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock x:Name="Arrow" Text="›" FontSize="20" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" RenderTransformOrigin="0.5,0.5"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="Card" Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,3,8">
      <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/>
     </Border>
     <Border x:Name="ChildrenHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="0,0,0,3" BorderBrush="#DDE8E0" BorderThickness="1,0,0,0" Padding="6,0,0,0"><ItemsPresenter/></Border>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
     <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ChildrenHost" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#EAF5ED"/><Setter TargetName="Card" Property="BorderBrush" Value="#84B69B"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="RootSurface" Background="#F1F5F2">
  <Grid><Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <Border Background="#FAFCFA" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Code Atlas" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding ReportName}" Foreground="{StaticResource Accent}" FontSize="14" Margin="20,7,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReportName}"/></StackPanel><TextBlock Text="{Binding SnapshotLabel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="架构规范" Click="OnArchitecture" Margin="0,0,8,0" ToolTip="规范、现状证据、整理路线和能力清单"/><Button Content="打开历史报告" Click="OnOpen" Margin="0,0,8,0" ToolTip="读取先前保存的分析结果，不重新扫描仓库"/><Button Content="分析仓库" Click="OnAnalyze" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
     <Button Content="取消" Click="OnCancel" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
   </Grid></Border>
   <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="20,16,20,0">
    <Grid.ColumnDefinitions><ColumnDefinition MinWidth="400" Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="DetailColumn" MinWidth="320" Width="420"/></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="0">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="116"/></Grid.RowDefinitions>
      <Grid Margin="20,17,20,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="代码地图" FontSize="24" FontWeight="Bold"/><TextBlock Text="展开功能 · 查看实现 · 追溯源码" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding FindingsLabel}" Click="OnFindings" IsEnabled="{Binding HasReport}" Margin="0,0,8,0"/><Button x:Name="ShowDetails" Content="查看详情" Click="OnShowDetails" Visibility="Collapsed"/></StackPanel>
      </Grid>
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1" Padding="12,9"><DockPanel>
       <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="↶" Click="OnUndo" IsEnabled="{Binding Session.CanUndo}" Padding="9,5" ToolTip="撤销浏览动作 Ctrl+Z"/><Button Content="↷" Click="OnRedo" IsEnabled="{Binding Session.CanRedo}" Padding="9,5" Margin="4,0,8,0"/><Button Content="结构" Click="OnTree" Padding="10,5"/><Button Content="连线" Click="OnGraph" Padding="10,5" Margin="4,0,0,0"/></StackPanel>
       <Grid Margin="12,0,0,0"><TextBox x:Name="SearchBox" MinWidth="110" Padding="9,5" Foreground="{StaticResource Ink}" ToolTip="按用途、名称或文件搜索 Ctrl+K" TextChanged="OnSearchChanged"/>
        <TextBlock Text="搜索用途、方法或文件…  Ctrl+K" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
      </DockPanel></Border>
      <Grid Grid.Row="2" Background="#F8FAF8">
       <TreeView x:Name="DirectoryTree" ItemsSource="{Binding Session.Roots}" SelectedItemChanged="OnTreeSelection" Background="Transparent" BorderThickness="0" Padding="12" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.ScrollChanged="OnTreeScroll" RequestBringIntoView="OnBringIntoView">
        <TreeView.ItemsPanel><ItemsPanelTemplate><local:AtlasVirtualizingPanel/></ItemsPanelTemplate></TreeView.ItemsPanel>
       </TreeView>
       <ScrollViewer x:Name="GraphScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="GraphCanvas"/></ScrollViewer>
       <Border x:Name="SearchPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="12" Background="White" BorderBrush="#A9CDB7" BorderThickness="1" CornerRadius="8" Padding="10" Panel.ZIndex="5">
        <DockPanel><TextBlock DockPanel.Dock="Top" Text="查找结果 · 最多 100 项 · 选中后回到所属位置" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,3,0,9"/>
         <ListBox x:Name="SearchResults" ItemsSource="{Binding Session.SearchResults}" MaxHeight="300" BorderThickness="0" SelectionChanged="OnSearchSelection" VirtualizingPanel.IsVirtualizing="True">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="550"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
        </DockPanel>
       </Border>
      </Grid>
      <Border Grid.Row="3" Background="#FBFDFB" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="146"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="全局小地图" FontWeight="SemiBold"/><TextBlock Text="点击定位 · 滚动同步" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,10"/><TextBlock Text="{Binding Session.CurrentModule.Title}" Foreground="{StaticResource Accent}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
       <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Session.Roots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <Button Content="{Binding Title}" Click="OnMinimap" Width="136" Margin="0,0,7,6" Padding="8,7"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#DFEEE4"/><Setter Property="BorderBrush" Value="#92BEA4"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Grid></Border>
     </Grid>
    </Border>
    <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ShowsPreview="False" DragCompleted="OnPanelResized" ToolTip="拖动调整目录与源码宽度；双击恢复" MouseDoubleClick="OnResetPanel" AutomationProperties.Name="调整目录与源码宽度"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border Background="Transparent"><Border Width="4" Height="50" Background="#B6CDBF" CornerRadius="2" VerticalAlignment="Center"/></Border></ControlTemplate></GridSplitter.Template></GridSplitter>
    <Border x:Name="DetailPanel" Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Panel.ZIndex="10">
     <DockPanel><Grid DockPanel.Dock="Top" Margin="20,16"><TextBlock Text="用途与证据" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseDetails" Content="×" Click="OnHideDetails" HorizontalAlignment="Right" Padding="9,3" Visibility="Collapsed"/></Grid>
      <Button DockPanel.Dock="Bottom" Content="查看源码摘录（只读）" Click="OnSource" IsEnabled="{Binding Session.CanViewSource}" Margin="20,12,20,18" Style="{StaticResource Primary}"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,8,20,4"><StackPanel>
       <TextBlock Text="{Binding Session.Breadcrumb}" FontSize="11" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,14"/>
       <TextBlock Text="{Binding Session.DetailTitle}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Session.DetailSummary}" FontSize="13" TextWrapping="Wrap" LineHeight="23" Margin="0,18,0,22"/>
       <TextBlock Text="{Binding Session.Selected.Basis}" FontSize="11" Foreground="#967438" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <Border Background="#F1F6F2" CornerRadius="7" Padding="12"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Session.Selected.Role}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Session.Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding Session.Selected.Role}" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Session.Selected.Effect}" Foreground="#9A783E" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
       <TextBlock Text="输入 · 参数与意图" FontWeight="SemiBold" Margin="0,25,0,12"/><TextBlock Text="{Binding Session.DetailInputs}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21"/>
       <TextBlock Text="输出 · 返回约定" FontWeight="SemiBold" Margin="0,25,0,12"/><TextBlock Text="{Binding Session.DetailOutputs}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21"/>
       <TextBlock Text="源码证据" FontWeight="SemiBold" Margin="0,25,0,12"/><TextBlock Text="{Binding Session.Selected.SourceLabel}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap"/>
       <TextBlock Text="自动换行 · 行号为原文件行号 · 仅展示附近摘录" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <Border Background="#F4F7F5" CornerRadius="7" Padding="9" Margin="0,12,0,0"><TextBox x:Name="SourcePreview" Text="{Binding Session.Source,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MaxHeight="270" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/></Border>
       <TextBlock Text="静态分析与显式声明；未解析项保留在质量与支持范围中。" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
      </StackPanel></ScrollViewer>
     </DockPanel>
    </Border>
   </Grid>
   <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="21,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
  </Grid>
 </Grid>
</Window>
